{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackjack-practice.local/schema/strategy-package-v1.json",
  "title": "Blackjack strategy evaluation package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "rules",
    "trueCountRounding",
    "chart",
    "fallbacks",
    "deviations",
    "insurance",
    "evenMoney",
    "bettingRamp"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "trueCountRounding": {
      "enum": ["nearest", "truncate", "floor"]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft", "pair"],
      "properties": {
        "hard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "h4",
            "h5",

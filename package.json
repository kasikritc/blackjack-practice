{
  "name": "blackjack-practice",
  "version": "0.2.0",
  "private": true,
  "description": "Mobile-friendly Hi-Lo blackjack card counting practice app.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @blackjack/shared",
    "watch:shared": "npm run dev -w @blackjack/shared",
    "dev:server": "npm run dev -w @blackjack/server",
    "dev:client": "npm run dev -w @blackjack/client",
    "dev": "npm run build:shared && concurrently -k -n shared,server,client -c gray,blue,green \"npm:watch:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build -w @blackjack/shared && npm run build -w @blackjack/server && npm run build -w @blackjack/client",
    "start": "node server/dist/index.js",
    "typecheck": "npm run build:shared && npm run typecheck -w @blackjack/server && npm run typecheck -w @blackjack/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:configure": "cmake -S sim -B sim/build -DCMAKE_BUILD_TYPE=Release",
    "sim:build": "cmake --build sim/build -j",
    "sim:devices": "sim/build/simulate-strategy devices",
    "sim:smoke": "sim/build/simulate-strategy run --config sim/configs/smoke.json --output /tmp/blackjack-sim-runs",
    "sim:export-png": "tsx scripts/export-chart-png.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.60.0",
    "prettier": "^3.4.2",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}

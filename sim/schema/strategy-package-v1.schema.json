            },
            "h13": {
              "$ref": "#/$defs/dealerCells"
            },
            "h14": {
              "$ref": "#/$defs/dealerCells"
            },
            "h15": {
              "$ref": "#/$defs/dealerCells"
            },
            "h16": {
              "$ref": "#/$defs/dealerCells"
            },
            "h17": {
              "$ref": "#/$defs/dealerCells"
            },
            "h18": {
              "$ref": "#/$defs/dealerCells"
            },
            "h19": {
              "$ref": "#/$defs/dealerCells"
            },
            "h20": {
              "$ref": "#/$defs/dealerCells"
            },
            "h21": {
              "$ref": "#/$defs/dealerCells"
            }
          }
        },
        "soft": {
          "type": "object",
          "additionalProperties": false,
          "required": ["s13", "s14", "s15", "s16", "s17", "s18", "s19", "s20", "s21"],
          "properties": {
            "s13": {
              "$ref": "#/$defs/dealerCells"
            },
            "s14": {
              "$ref": "#/$defs/dealerCells"
            },
            "s15": {
              "$ref": "#/$defs/dealerCells"
            },
            "s16": {
              "$ref": "#/$defs/dealerCells"
            },
            "s17": {
              "$ref": "#/$defs/dealerCells"
            },
            "s18": {
              "$ref": "#/$defs/dealerCells"
            },
            "s19": {
              "$ref": "#/$defs/dealerCells"
            },
            "s20": {
              "$ref": "#/$defs/dealerCells"
            },
            "s21": {
              "$ref": "#/$defs/dealerCells"
            }
          }
        },
        "pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pA", "p10", "p9", "p8", "p7", "p6", "p5", "p4", "p3", "p2"],
          "properties": {
            "pA": {
              "$ref": "#/$defs/dealerCells"

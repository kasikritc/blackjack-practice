            },
            "h20": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h21": {
              "$ref": "#/$defs/fallbackCells"
            }
          }
        },
        "soft": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "s13": {
              "$ref": "#/$defs/fallbackCells"
            },
            "s14": {
              "$ref": "#/$defs/fallbackCells"
            },
            "s15": {
              "$ref": "#/$defs/fallbackCells"
            },
            "s16": {
              "$ref": "#/$defs/fallbackCells"
            },
            "s17": {
              "$ref": "#/$defs/fallbackCells"
            },
            "s18": {

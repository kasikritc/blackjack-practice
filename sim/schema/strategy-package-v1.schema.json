            },
            "p9": {
              "$ref": "#/$defs/dealerCells"
            },
            "p8": {
              "$ref": "#/$defs/dealerCells"
            },
            "p7": {
              "$ref": "#/$defs/dealerCells"
            },
            "p6": {
              "$ref": "#/$defs/dealerCells"
            },
            "p5": {
              "$ref": "#/$defs/dealerCells"
            },
            "p4": {
              "$ref": "#/$defs/dealerCells"
            },
            "p3": {
              "$ref": "#/$defs/dealerCells"
            },
            "p2": {
              "$ref": "#/$defs/dealerCells"
            }
          }
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "h4": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h5": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h6": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h7": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h8": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h9": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h10": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h11": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h12": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h13": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h14": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h15": {
              "$ref": "#/$defs/fallbackCells"
            },
            "h16": {

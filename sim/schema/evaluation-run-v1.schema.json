{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackjack-practice.local/schema/evaluation-run-v1.json",
  "title": "Blackjack strategy evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "seed",
    "strategy",
    "mode",
    "rounds",
    "paths",
    "penetrationPercent",
    "observerSeats",
    "roundsPerHour",
    "confidenceZ",
    "riskBankrollUnits",
    "retention"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["fresh-round", "continuous-shoe"]
    },
    "rounds": {
      "type": "integer",
      "minimum": 1
    },
    "paths": {
      "type": "integer",
      "minimum": 1
    },
    "penetrationPercent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 100
    },
    "observerSeats": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "roundsPerHour": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "confidenceZ": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "riskBankrollUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sampleEvery", "acknowledgeLargeOutput"],
      "properties": {
        "mode": {
          "enum": ["aggregate", "sampled", "full"]
        },
        "sampleEvery": {
          "type": "integer",
          "minimum": 1
        },
        "acknowledgeLargeOutput": {
          "type": "boolean"
        }
      }
    }
  }
}

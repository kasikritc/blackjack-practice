          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pA": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p10": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p9": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p8": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p7": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p6": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p5": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p4": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p3": {
              "$ref": "#/$defs/fallbackCells"
            },
            "p2": {
              "$ref": "#/$defs/fallbackCells"
            }
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionDeviation"
      }
    },
    "insurance": {
      "$ref": "#/$defs/sidePolicy"
    },
    "evenMoney": {
      "$ref": "#/$defs/sidePolicy"
    },
    "bettingRamp": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atOrAbove", "units"],
        "properties": {
          "atOrAbove": {
            "type": "integer"
          },
          "units": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "enum": ["hit", "stand", "double", "split", "surrender"]
    },
    "dealerCells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["2", "3", "4", "5", "6", "7", "8", "9", "10", "A"],
      "properties": {
        "2": {
          "$ref": "#/$defs/action"
        },
        "3": {
          "$ref": "#/$defs/action"
        },
        "4": {
          "$ref": "#/$defs/action"
        },
        "5": {
          "$ref": "#/$defs/action"
        },
        "6": {
          "$ref": "#/$defs/action"
        },
        "7": {
          "$ref": "#/$defs/action"
        },
        "8": {
          "$ref": "#/$defs/action"
        },
        "9": {
          "$ref": "#/$defs/action"
        },
        "10": {
          "$ref": "#/$defs/action"
        },
        "A": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "fallbackCells": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "2": {
          "enum": ["hit", "stand"]
        },
        "3": {
          "enum": ["hit", "stand"]
        },
        "4": {
          "enum": ["hit", "stand"]
        },
        "5": {
          "enum": ["hit", "stand"]
        },
        "6": {
          "enum": ["hit", "stand"]
        },
        "7": {
          "enum": ["hit", "stand"]
        },
        "8": {
          "enum": ["hit", "stand"]
        },
        "9": {
          "enum": ["hit", "stand"]
        },
        "10": {
          "enum": ["hit", "stand"]
        },
        "A": {
          "enum": ["hit", "stand"]
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decks",
        "dealerHitsSoft17",
        "dealerPeek",
        "dealerHoleCard",
        "blackjackPayout",
        "doubleRule",
        "doubleAfterSplit",
        "surrender",
        "maxSplitHands",
        "resplitAces",
        "hitSplitAces",
        "oneCardSplitAces",
        "insurance",
        "splitTensByValue",
        "customRules"
      ],
      "properties": {
        "decks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "dealerHitsSoft17": {
          "type": "boolean"
        },
        "dealerPeek": {
          "const": true
        },
        "dealerHoleCard": {
          "const": true
        },
        "blackjackPayout": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$"
        },
        "doubleRule": {
          "enum": ["none", "anyTwo", "hardOnly", "nineToEleven", "tenToEleven"]
        },
        "doubleAfterSplit": {
          "type": "boolean"
        },
        "surrender": {
          "enum": ["none", "late", "early"]
        },
        "maxSplitHands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "resplitAces": {
          "type": "boolean"
        },
        "hitSplitAces": {
          "type": "boolean"
        },
        "oneCardSplitAces": {
          "type": "boolean"
        },
        "insurance": {
          "type": "boolean"
        },
        "splitTensByValue": {
          "type": "boolean"
        },
        "customRules": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "actionDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "rowKey", "dealerUpcard", "comparison", "trueCount", "action"],
      "properties": {
        "category": {
          "enum": ["hard", "soft", "pair"]
        },
        "rowKey": {
          "type": "string"
        },
        "dealerUpcard": {
          "enum": ["2", "3", "4", "5", "6", "7", "8", "9", "10", "A"]
        },
        "comparison": {
          "enum": ["atOrAbove", "atOrBelow"]
        },
        "trueCount": {
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "fallback": {
          "enum": ["hit", "stand"]
        }
      }
    },
    "sideDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "trueCount", "decision"],
      "properties": {
        "comparison": {
          "enum": ["atOrAbove", "atOrBelow"]
        },
        "trueCount": {
          "type": "integer"
        },
        "decision": {
          "enum": ["take", "decline"]
        }
      }
    },
    "sidePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "deviations"],
      "properties": {
        "base": {
          "enum": ["take", "decline"]
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sideDeviation"
          }
        }
      }
    }
  }
}
